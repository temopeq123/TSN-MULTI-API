<Window x:Class="TSN_MULTI_API.VerificationReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты проверки подписей" Width="800" Height="550"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Background="#FFF8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с иконкой и итогом -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock x:Name="TxtIcon" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtSummary" FontSize="16" FontWeight="SemiBold" Foreground="#FF0F172A" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Карточка с детальным отчетом -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
            <TextBox x:Name="TxtDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="12" FontFamily="Consolas" FontSize="13"
                     Background="Transparent" Foreground="#FF334155"/>
        </Border>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2" Content="Закрыть" Width="120" Height="38" HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButtonStyle}" Click="BtnClose_Click"/>
    </Grid>
</Window>