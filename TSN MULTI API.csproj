<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TSN_MULTI_API</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CryptoPro.Security.Cryptography" Version="2026.7.28" />
    <PackageReference Include="CryptoPro.Security.Cryptography.Pkcs" Version="2026.7.28" />
    <PackageReference Include="CryptoPro.Security.Cryptography.Xml" Version="2026.7.28" />
  </ItemGroup>

</Project>
