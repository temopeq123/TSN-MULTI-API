<Window x:Class="TSN_MULTI_API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TSN MULTI API - Госключ (История)" Height="750" Width="1000" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Background="#FF2D2D30" Margin="0,0,15,0">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="Меню" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Госключ" Height="35" Margin="0,0,0,5" Background="#FF3F3F46" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Основная рабочая область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtHeader" Text="Госключ - Управление и История" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- ПАНЕЛЬ ГОСКЛЮЧ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Настройки ЭП и Отладка -->
                    <GroupBox Header="Параметры подключения" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Сертификат ЭП:" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CertComboBox" Grid.Column="0" DisplayMemberPath="SubjectName" SelectedValuePath="Thumbprint"/>
                                <Button Content="Свойства" Grid.Column="1" Width="75" Margin="8,0,0,0" Click="BtnCertProperties_Click"/>
                                <Button Content="Обновить" Grid.Column="2" Width="75" Margin="8,0,0,0" Click="RefreshCerts_Click"/>
                            </Grid>

                            <TextBlock Text="API-Key (UUID):" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtApiKeyBox" Height="25" Margin="0,0,0,8" Text="60904342-e040-4180-b037-e55d313c6d3a"/>

                            <TextBlock Text="Access Token (из Postman или авто):" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtManualTokenBox" Height="25" Margin="0,0,0,5"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Отправка нового документа -->
                    <GroupBox Header="Новая отправка" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Документ (PDF):" FontWeight="Bold"/>
                            <Grid Margin="0,3,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFilePath" Height="25" IsReadOnly="True" Grid.Column="0"/>
                                <Button Content="Обзор..." Width="90" Margin="8,0,0,0" Grid.Column="1" Click="BtnSelectFile_Click"/>
                            </Grid>

                            <TextBlock Text="СНИЛС получателя:" FontWeight="Bold"/>
                            <TextBox x:Name="TxtSnils" Height="25" Margin="0,3,0,8" MaxLength="14" TextChanged="TxtSnils_TextChanged"/>

                            <TextBlock Text="Описание:" FontWeight="Bold"/>
                            <TextBox x:Name="TxtDescription" Height="25" Margin="0,3,0,12" Text="Членская книжка ТСН Сапожок"/>

                            <Button Content="Передать заявку в Госключ" Width="220" Height="35" HorizontalAlignment="Left" Click="PushArchiveSmartAsync_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ИСТОРИЯ ЗАЯВЛЕНИЙ И СКАЧИВАНИЕ -->
                    <GroupBox Header="История заявлений (Автосохранение)" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Заявка считается доставленной только после успешного статуса Госключа. По отказанной заявке результат недоступен." FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                            <ListView x:Name="OrdersListView" Height="160" Margin="0,0,0,8">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Order ID" Width="90" DisplayMemberBinding="{Binding OrderId}"/>
                                        <GridViewColumn Header="Файл" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="СНИЛС" Width="100" DisplayMemberBinding="{Binding Snils}"/>
                                        <GridViewColumn Header="Дата" Width="120" DisplayMemberBinding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                        <GridViewColumn Header="Статус в Госключе" Width="180" DisplayMemberBinding="{Binding StatusName}"/>
                                        <GridViewColumn Header="Код статуса" Width="130" DisplayMemberBinding="{Binding StateOrgStatusCode}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Проверить статус выбранного" Width="190" Height="30" Margin="0,0,10,0" Click="BtnCheckSelectedStatus_Click"/>
                                <Button Content="Скачать подписанные файлы (.sig/.pdf)" Width="240" Height="30" Click="BtnDownloadSignedFiles_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Журнал логов -->
                    <TextBlock Text="Журнал операций:" FontWeight="Bold" Margin="0,5,0,2"/>
                    <TextBox x:Name="TxtStatus" Height="90" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FFF1F1F1" FontFamily="Consolas"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
