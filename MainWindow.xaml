<Window x:Class="TSN_MULTI_API.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TSN MULTI API — Госключ и ФССП" Height="780" Width="1080" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}">
            <DockPanel Margin="16,20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TSN MULTI API" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Работа с Госключом и АПИ" Foreground="#FF94A3B8" FontSize="12" Margin="0,4,0,24"/>
                </StackPanel>

                <StackPanel>
                    <Button x:Name="BtnNavGoskey" Style="{StaticResource NavButtonStyle}" Content="Отправка в Госключ" Click="NavGoskey_Click"/>
                    <Button x:Name="BtnNavFssp" Style="{StaticResource NavButtonStyle}" Content="ФССП (Ход ИП)" Click="NavFssp_Click"/>
                    <Button x:Name="BtnNavAddressBook" Style="{StaticResource NavButtonStyle}" Content="Адресная книга" Click="NavAddressBook_Click"/>
                    <Button x:Name="BtnNavSettings" Style="{StaticResource NavButtonStyle}" Content="Настройки" Click="NavSettings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Контент -->
        <Grid Grid.Column="1" Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtHeader" FontSize="22" FontWeight="Bold" Foreground="#FF0F172A" Margin="0,0,0,16"/>

            <!-- === Отправка в Госключ === -->
            <ScrollViewer x:Name="PanelGoskey" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820">
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Сертификат для подписи" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtActiveCertSummary" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Обновить список сертификатов" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshCerts_Click"/>
                                <Button Content="Свойства сертификата" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnCertProperties_Click"/>
                                <Button Content="Открыть настройки" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="NavSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <GroupBox Header="Новая отправка">
                        <StackPanel>
                            <TextBlock Text="Получатель из адресной книги" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbAddressBookPick" Grid.Column="0" DisplayMemberPath="FullName" SelectionChanged="CmbAddressBookPick_SelectionChanged"/>
                                <Button Grid.Column="1" Content="Книга…" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="NavAddressBook_Click"/>
                            </Grid>

                            <TextBlock Text="Документы для подписания (до 20 файлов)" FontWeight="SemiBold"/>
                            <Grid Margin="0,6,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFilePath" IsReadOnly="True" Grid.Column="0"/>
                                <Button Content="Выбрать файлы…" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnSelectFile_Click"/>
                            </Grid>

                            <TextBlock Text="Тип подписи получателя" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                                <RadioButton x:Name="RbUkep" Content="УКЭП — подпись получателя УКЭП" GroupName="SignatureTypeGroup" IsChecked="True" Checked="SignatureType_Checked" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbUnep" Content="УНЭП — подпись получателя УНЭП" GroupName="SignatureTypeGroup" Checked="SignatureType_Checked"/>
                            </StackPanel>

                            <TextBlock Text="СНИЛС получателя" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtGoskeySnils" MaxLength="14" Margin="0,6,0,12" TextChanged="TxtSnils_TextChanged"/>

                            <TextBlock Text="Описание документа" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtDescription" Margin="0,6,0,16"/>

                            <Button Content="Передать заявку в Госключ" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Height="38" Click="PushArchiveSmartAsync_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="История заявлений">
                        <StackPanel>
                            <TextBlock Text="Заявка считается доставленной после успешного статуса в Госключе." FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <ListView x:Name="OrdersListView" Height="180" Margin="0,0,0,10">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="№ заявки" Width="90" DisplayMemberBinding="{Binding OrderId}"/>
                                        <GridViewColumn Header="Файл" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="СНИЛС" Width="110" DisplayMemberBinding="{Binding Snils}"/>
                                        <GridViewColumn Header="Дата" Width="130" DisplayMemberBinding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                        <GridViewColumn Header="Статус" Width="200" DisplayMemberBinding="{Binding StatusName}"/>
                                        <GridViewColumn Header="Код" Width="100" DisplayMemberBinding="{Binding StateOrgStatusCode}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Проверить статус" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCheckSelectedStatus_Click"/>
                                <Button Content="Скачать подписи (.sig)" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Click="BtnDownloadSignedFiles_Click"/>
                                <Button Content="Проверить подписи" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnVerifySignedFiles_Click"/>
                                <Button Content="Удалить заявку" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnDeleteOrder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <TextBlock Text="Журнал операций" FontWeight="SemiBold" Margin="0,4,0,6"/>
                    <TextBox x:Name="TxtStatus" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FFF8FAFC" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>

            <!-- === ФССП === -->
            <ScrollViewer x:Name="PanelFssp" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820">

                    <!-- ФОРМА ОТПРАВКИ -->
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Запрос информации из ФССП" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Тип запроса" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbFsspRequestType" Margin="0,6,0,0" SelectionChanged="CmbFsspRequestType_SelectionChanged">
                                        <ComboBoxItem Tag="CourseIP">Ход ИП</ComboBoxItem>
                                        <ComboBoxItem Tag="ExistIP" IsSelected="True">Наличие ИП</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" x:Name="PanelFsspDeloNum" Visibility="Collapsed">
                                    <TextBlock Text="Номер дела (например, 23545/20/69025-ИП)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtFsspDeloNum" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="СНИЛС заявителя (11 цифр, без тире и пробелов)" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtFsspSnils" MaxLength="11" Margin="0,6,0,12"/>

                            <TextBlock Text="ФИО заявителя полностью" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtFsspFullName" Margin="0,6,0,12"/>

                            <TextBlock Text="Дата рождения (ГГГГ-ММ-ДД)" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtFsspBirthDate" Margin="0,6,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Тип заявителя" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbFsspApplicantType" Margin="0,6,0,0" SelectionChanged="CmbFsspApplicantType_SelectionChanged">
                                        <ComboBoxItem Content="Физ. лицо" Tag="FL" IsSelected="True"/>
                                        <ComboBoxItem Content="Юр. лицо" Tag="UL"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Сторона ИП" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbFsspComplainerType" Margin="0,6,0,0">
                                        <ComboBoxItem Content="Взыскатель" Tag="1"/>
                                        <ComboBoxItem Content="Должник" Tag="2" IsSelected="True"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пол заявителя" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbFsspGender" Margin="0,6,0,0">
                                        <ComboBoxItem Content="Мужской" Tag="1" IsSelected="True"/>
                                        <ComboBoxItem Content="Женский" Tag="2"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- ПАНЕЛЬ ЮРЛИЦА -->
                            <StackPanel x:Name="PanelFsspLegalEntity" Margin="0,0,0,16" Visibility="Collapsed">
                                <TextBlock Text="Данные организации" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Название (кратко)" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBox x:Name="TxtFsspCompName" Text="ТСН «Сапожок»" Margin="0,0,0,8"/>
                                        <TextBlock Text="ИНН" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBox x:Name="TxtFsspCompInn" Margin="0,0,0,8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Адрес (текстом)" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBox x:Name="TxtFsspCompAddress" Margin="0,0,0,8"/>
                                        <TextBlock Text="ОГРН" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBox x:Name="TxtFsspCompOgrn" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="BtnFsspSend" Content="Отправить запрос в ФССП" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Height="38" Click="BtnFsspSend_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ИСТОРИЯ ФССП -->
                    <GroupBox Header="История заявлений ФССП" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Статус 3 означает «Услуга оказана», после чего можно скачивать ответ." FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <ListView x:Name="FsspOrdersListView" Height="150" Margin="0,0,0,10">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="№ заявки" Width="100" DisplayMemberBinding="{Binding OrderId}"/>
                                        <GridViewColumn Header="Тип запроса" Width="120" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="СНИЛС" Width="110" DisplayMemberBinding="{Binding Snils}"/>
                                        <GridViewColumn Header="Дата" Width="130" DisplayMemberBinding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                        <GridViewColumn Header="Статус" Width="200" DisplayMemberBinding="{Binding StatusName}"/>
                                        <GridViewColumn Header="Код" Width="60" DisplayMemberBinding="{Binding StateOrgStatusCode}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Проверить статус" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCheckFsspStatus_Click"/>
                                <Button Content="Скачать ответ" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Click="BtnDownloadFsspResult_Click"/>
                                <Button Content="Удалить заявку" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnDeleteFsspOrder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- ЖУРНАЛ -->
                    <TextBlock Text="Журнал операций ФССП" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFsspStatusLog" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FFF8FAFC" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>

            <!-- === Адресная книга === -->
            <Grid x:Name="PanelAddressBook" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                    <DataGrid x:Name="AddressBookGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              SelectionChanged="AddressBookGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Отчество" Binding="{Binding Patronymic}" Width="*"/>
                            <DataGridTextColumn Header="СНИЛС" Binding="{Binding Snils}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Фамилия" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtAbLastName" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Имя" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtAbFirstName" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Отчество" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtAbPatronymic" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="СНИЛС" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtAbSnils" MaxLength="14" Margin="0,6,0,0" TextChanged="TxtAbSnils_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnAbSave" Content="Сохранить запись" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAbSave_Click"/>
                            <Button x:Name="BtnAbNew" Content="Новая запись" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnAbNew_Click"/>
                            <Button x:Name="BtnAbDelete" Content="Удалить" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="BtnAbDelete_Click"/>
                            <Button Content="Выбрать для отправки" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Click="BtnAbUseForSend_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- === Настройки === -->
            <ScrollViewer x:Name="PanelSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640">
                    <TextBlock Text="Здесь задаются значения по умолчанию. Их не нужно менять при каждой отправке." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"/>

                    <GroupBox Header="Сертификат электронной подписи">
                        <StackPanel>
                            <TextBlock Text="Сертификат по умолчанию" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CertComboBox" DisplayMemberPath="SubjectName" SelectedValuePath="Thumbprint" SelectionChanged="CertComboBox_SelectionChanged"/>
                                <Button Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Click="RefreshCerts_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Папки и файлы">
                        <StackPanel>
                            <TextBlock Text="Папка для сохранения заявлений и подписей" FontWeight="SemiBold"/>
                            <Grid Margin="0,6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsStatementsDir"/>
                                <Button Grid.Column="1" Content="…" Width="36" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BtnBrowseStatementsDir_Click"/>
                            </Grid>

                            <TextBlock Text="Папка для выбора документов по умолчанию" FontWeight="SemiBold"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsDocsDir"/>
                                <Button Grid.Column="1" Content="…" Width="36" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BtnBrowseDocsDir_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Подключение к API">
                        <StackPanel>
                            <TextBlock Text="API-Key (UUID)" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtApiKeyBox" Margin="0,6,0,14"/>

                            <TextBlock Text="Описание документа по умолчанию" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtSettingsDefaultDescription" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Height="40" Width="200" Click="BtnSaveSettings_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>